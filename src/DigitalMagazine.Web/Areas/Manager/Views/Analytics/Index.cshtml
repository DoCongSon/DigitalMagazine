@model List<DigitalMagazine.Application.Analytics.ArticleStatsDto>
@{
    ViewBag.Title = "Thống Kê Truy Cập";
    // Using Piranha Manager layout
    Layout = "~/Areas/Manager/Shared/_Layout.cshtml";
}

<div class="top">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">Cài đặt</li>
            <li class="breadcrumb-item active" aria-current="page">Thống Kê</li>
        </ol>
    </nav>

    <div class="container-fluid">
        <div class="top-nav">
            <h1 class="mb-0">Thống Kê Lượt Xem Bài Viết</h1>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
                    <h5 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-trophy text-warning mr-2"></i> Top 20 Bài Viết Nổi Bật Nhất
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th class="px-4 py-3">Tên bài viết</th>
                                    <th class="py-3">Đường dẫn</th>
                                    <th class="text-center py-3">Views Hôm Nay</th>
                                    <th class="text-center py-3">Tổng Views</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="px-4">
                                                <strong><a href="~/@item.Slug" target="_blank" class="text-dark text-decoration-none">@item.Title</a></strong>
                                            </td>
                                            <td class="text-muted"><small>@item.Slug</small></td>
                                            <td class="text-center">
                                                <span class="badge badge-success px-2 py-1 rounded-pill" style="font-size: 0.9em;">
                                                    <i class="fas fa-fire mr-1"></i> @item.ViewsToday
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge badge-primary px-2 py-1 rounded-pill" style="font-size: 0.9em;">
                                                    @item.TotalViews
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="fas fa-chart-line fa-3x mb-3 text-light"></i><br/>
                                            Chưa có dữ liệu thống kê lượt đọc. <br/>
                                            <small>Hãy thử truy cập các bài viết ở trang chủ để hệ thống ghi nhận.</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
