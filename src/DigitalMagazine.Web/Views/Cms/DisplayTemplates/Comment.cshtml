@model Piranha.Models.Comment

<div class="row comment mb-4">
    <div class="col-2">
        <img class="rounded img-fluid" src="data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='160' height='160' fill='%236c757d' class='bi bi-person-circle' viewBox='0 0 16 16'%3E%3Cpath d='M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z'/%3E%3Cpath fill-rule='evenodd' d='M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z'/%3E%3C/svg%3E" alt="@Model.Author">
    </div>
    <div class="col-10">
        @if (!string.IsNullOrEmpty(Model.Url))
        {
            <h5><a href="@Model.Url" target="_blank">@Model.Author</a> - <small>@Model.Created.ToLongDateString()</small></h5>
        }
        else
        {
            <h5>@Model.Author - <small>@Model.Created.ToLongDateString()</small></h5>
        }
        <p>
            @Model.Body
        </p>
    </div>
</div>
